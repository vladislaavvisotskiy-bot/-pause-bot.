# Токен вашего бота — получить у @BotFather в Telegram
BOT_TOKEN=

# ID таблицы — это часть ссылки между /d/ и /edit
# https://docs.google.com/spreadsheets/d/ЭТА_ЧАСТЬ/edit
GOOGLE_SHEET_ID=

# Путь к JSON-файлу сервисного аккаунта Google (см. README, шаг 2)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Ваш личный Telegram chat_id (админ) — сюда будут приходить утренние отчёты
# и уведомления о новых точках. Как узнать — см. README.
ADMIN_CHAT_ID=

# Во сколько закрывается приём заказов на сегодня (часы:минуты, время Ташкента)
ORDER_CUTOFF_TIME=10:00

# Во сколько закрывается возможность отменить уже сделанный заказ
CANCEL_CUTOFF_TIME=09:00

# Во сколько заказ дня в "Мои заказы" переходит из "🌿 Принят" в "✅ Завершён"
ORDER_COMPLETE_TIME=13:00

# Во сколько бот сам присылает админу тексты для кухни/курьера
MORNING_REPORT_TIME=10:05

# Во сколько бот мягко напоминает прислать скрин оплаты тем, кто выбрал
# "пришлю позже" и ещё не прислал
PAYMENT_REMINDER_TIME=13:30

# Публичный HTTPS-адрес Mini App "Маршрут курьера" (Railway: Settings →
# Networking → Generate Domain). С https://, без слэша на конце. Пока пусто
# — кнопки маршрута в меню бота не показываются никому.
WEBAPP_URL=
